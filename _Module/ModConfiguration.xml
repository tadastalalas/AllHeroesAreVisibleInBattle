<?xml version="1.0" encoding="utf-8"?>
<!--
  All Heroes Are Visible In Battle - configuration.

  This file is ONLY used when Mod Configuration Menu (MCM) is NOT installed.
  With MCM installed, use: Options -> Mod Options -> All Heroes Are Visible In Battle.

  HighlightMode
    Hold   - heroes are outlined only while the key is held down.
    Toggle - press once to turn the outlines on, press again to turn them off.

  KeyboardKey / ControllerKey
    Both are active at the same time. Either one triggers the highlight.
    Use None to disable that input.

    Keyboard values:
      LeftAlt, RightAlt, LeftControl, RightControl, LeftShift, RightShift,
      Tab, CapsLock, Tilde, Space, Q, E, R, T, F, G, H, Z, X, C, V, B, N, M,
      MiddleMouseButton, X1MouseButton, X2MouseButton, F1 ... F12

    Controller values:
      ControllerLBumper   (LB)              ControllerRBumper   (RB)
      ControllerLTrigger  (LT)              ControllerRTrigger  (RT)
      ControllerLThumb    (L3)              ControllerRThumb    (R3)
      ControllerLOption   (View / Back)     ControllerROption   (Menu / Start)
      ControllerLUp / ControllerLDown / ControllerLLeft / ControllerLRight   (D-Pad)
      ControllerRUp (Y) / ControllerRDown (A) / ControllerRLeft (X) / ControllerRRight (B)

  HighlightDistance
    Heroes further than this many metres from the camera are not outlined.
    Whole number, allowed range: 10 - 200. Default: 30.

  ShowNames
    true  - hero names are drawn above their heads while highlighted.
    false - outlines only.

  LoggingEnabled
    true  - writes debug lines to Modules\AllHeroesAreVisibleInBattle\logs\ (English only).
    false - only problems are written there. Default: false.

  If this file is missing or broken, the mod recreates it with the default settings.
-->
<ModConfiguration>
    <General>
        <HighlightMode>Hold</HighlightMode>
        <KeyboardKey>LeftAlt</KeyboardKey>
        <ControllerKey>None</ControllerKey>
        <HighlightDistance>30</HighlightDistance>
        <ShowNames>true</ShowNames>
    </General>
    <TechnicalSettings>
        <LoggingEnabled>false</LoggingEnabled>
    </TechnicalSettings>
</ModConfiguration>
